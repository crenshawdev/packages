# Ghost integration keys. Copy to .env (gitignored) and fill with real values
# from Ghost admin > Settings > Integrations > your Custom Integration.

# --- Admin API (seed script only; NEVER shipped to the front end) ---
# Used by scripts/seed-ghost.mjs to create/update posts. Admin key is `id:secret`.
GHOST_ADMIN_API_URL=https://ghost.jcrenshaw.dev
GHOST_ADMIN_API_KEY=your_admin_api_key_id:your_admin_api_secret

# --- Content API (front end, read-only) ---
# The public-facing render layer reads content through these (Phase 3 cutover).
GHOST_URL=https://ghost.jcrenshaw.dev
GHOST_CONTENT_API_KEY=your_content_api_key
