---
import { ROOMS } from '../lib/rooms';
import type { RoomId } from '../lib/rooms';

interface Props {
  active?: RoomId;
  base?: string;
}
const { active, base = '' } = Astro.props;

// Icon-only dock, like the real Noctalia one. Each app carries an aria-label and
// a data-label; the name shows on hover/focus (desktop) or under the icon (mobile).
const iconSvg: Record<RoomId, string> = {
  writing:
    '<svg viewBox="0 0 24 24"><path d="M7 3.5h7l4 4V20.5H7z"/><path d="M14 3.5V8h4"/><path d="M9.5 12.5h7M9.5 15.5h5"/></svg>',
  code:
    '<svg viewBox="0 0 24 24"><rect x="4" y="4" width="6.5" height="6.5" rx="1.4"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.4"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.4"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.4"/></svg>',
  stack:
    '<svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="5" rx="1.6"/><rect x="3.5" y="14.5" width="17" height="5" rx="1.6"/><circle cx="7" cy="7" r="0.5"/><circle cx="7" cy="17" r="0.5"/></svg>',
  me:
    '<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 19.5c0-3.7 3-5.6 6.5-5.6s6.5 1.9 6.5 5.6"/></svg>',
  work:
    '<svg viewBox="0 0 24 24"><path d="M4 5.5h16v10H9l-4 3.5v-3.5H4z"/></svg>',
};
---

<nav class="dock" aria-label="Rooms">
  {ROOMS.map((r) => (
    <a
      class="dock-app"
      href={`${base}${r.href}`}
      aria-label={r.label}
      data-label={r.label}
      aria-current={active === r.id ? 'page' : undefined}
    >
      <span class="icon" aria-hidden="true" set:html={iconSvg[r.id]} />
    </a>
  ))}
</nav>
