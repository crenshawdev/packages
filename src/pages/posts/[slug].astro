---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Subscribe from '../../components/Subscribe.astro';

export async function getStaticPaths() {
  const all = await getCollection('posts');
  const posts = all
    .filter((p) => p.data.type === 'post' && p.data.status !== 'draft' && p.data.visibility !== 'private')
    .sort((a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.data.slug ?? post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
      index: posts.length - i,
    },
  }));
}

const { post, newer, older, index } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const d = post.data.published_at;
const filed = `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;
const words = post.body.trim().split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const wordsFmt = new Intl.NumberFormat('en-US').format(words);
const tag = post.data.tags?.[0] ?? 'note';
const num = String(index).padStart(2, '0');
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt ?? post.data.meta_description ?? undefined}
  windowTitle={post.data.title}
  windowSeg="writing"
  active="writing"
>
  <article class="post">
    <header>
      <p class="room-eyebrow">no.{num} · {tag}</p>
      <h1>{post.data.title}</h1>
      <div class="byline">
        <span><span class="k">filed</span><span class="v">{filed}</span></span>
        <span><span class="k">read</span><span class="v">{minutes} min</span></span>
        <span><span class="k">words</span><span class="v">{wordsFmt}</span></span>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <Subscribe />

    <div class="post-foot">
      <a href={`${base}/writing`}>← index</a>
      {newer ? (
        <a href={`${base}/posts/${newer.data.slug ?? newer.id}`}>next: {newer.data.title} →</a>
      ) : older ? (
        <a href={`${base}/posts/${older.data.slug ?? older.id}`}>← previous: {older.data.title}</a>
      ) : null}
    </div>
  </article>
</BaseLayout>
