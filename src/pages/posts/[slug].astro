---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, renderBody } from '../../lib/content';

const slug = Astro.params.slug;
const posts = await getPublishedPosts();
const i = posts.findIndex((p) => p.slug === slug);
if (i === -1) {
  return new Response(null, { status: 404 });
}

const post = posts[i];
const newer = posts[i - 1] ?? null;
const older = posts[i + 1] ?? null;
const index = posts.length - i;
const { Content } = await renderBody(post.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const d = post.publishedAt;
const filed = `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;
const words = post.body.trim().split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const wordsFmt = new Intl.NumberFormat('en-US').format(words);
const tag = post.tags[0] ?? 'note';
const num = String(index).padStart(2, '0');

// Per-post social card: use the Ghost feature image (an absolute
// https://ghost.jcrenshaw.dev/... URL) when present; otherwise leave undefined
// so BaseLayout falls back to the site-wide /og-image.png.
const ogImage =
  typeof post.featureImage === 'string' && post.featureImage.length > 0
    ? post.featureImage
    : undefined;
---

<BaseLayout
  title={post.title}
  description={post.excerpt ?? post.metaDescription ?? undefined}
  windowTitle={post.title}
  windowSeg="writing"
  active="writing"
  ogImage={ogImage}
>
  <article class="post">
    <header>
      <p class="room-eyebrow">no.{num} · {tag}</p>
      <h1>{post.title}</h1>
      <div class="byline">
        <span><span class="k">filed</span><span class="v">{filed}</span></span>
        <span><span class="k">read</span><span class="v">{minutes} min</span></span>
        <span><span class="k">words</span><span class="v">{wordsFmt}</span></span>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="post-foot">
      <a href={`${base}/writing`}>← index</a>
      {newer ? (
        <a href={`${base}/posts/${newer.slug}`}>next: {newer.title} →</a>
      ) : older ? (
        <a href={`${base}/posts/${older.slug}`}>← previous: {older.title}</a>
      ) : null}
    </div>
  </article>
</BaseLayout>
