---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Work"
  description="Work with John Crenshaw — deciding what to build, what to leave alone, and where AI actually belongs."
  windowTitle="Work"
  active="work"
>
  <div class="room-head">
    <h1 class="room-title">Work with me</h1>
    <p class="room-lead">The right tool for the job, and telling you when you don't need one.</p>
  </div>

  <div class="prose">
    <p>
      Quietly here when it's useful, not the reason the house exists. I help teams decide what to
      build, what to leave alone, and where AI earns its place and where it doesn't — the same
      honest scoping I'd want on the other side of the table.
    </p>
    <p>
      If that's the conversation you're after,
      <a href="mailto:work@jcrenshaw.dev?subject=Working%20together">send a note</a>.
    </p>
  </div>
</BaseLayout>
