---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestCode } from '../lib/latestCode';
import { getPublishedPosts } from '../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const posts = await getPublishedPosts();
const latest = posts[0];
const latestHref = `${base}/posts/${latest.slug}`;

const latestCode = await getLatestCode();

// The "now" line in the lately strip — draft, set this to whatever is true today.
const now = 'running my own metal — Proxmox, self-hosted';

const markSrc = `${base}/favicon.svg`;
---

<BaseLayout
  title="John Crenshaw"
  description="John Crenshaw — I build software for the Linux desktop, write about doing it honestly, and run most of my own infrastructure."
>
  <section class="home">
    <h1 class="sr-only">John Crenshaw — software, writing, and a Linux desktop</h1>

    <img class="home-mark" src={markSrc} alt="" width="60" height="60" />
    <p class="home-name">John Crenshaw</p>
    <p class="home-line">
      I build software for the Linux desktop, write about doing it honestly, and run most of my
      own infrastructure. <span>Everything I make and think lives here — open a room.</span>
    </p>

    <div class="lately">
      <span class="li"><span class="k">writing</span> <a href={latestHref}>{latest.title}</a></span>
      <span class="li">
        <span class="k">shipping</span>
        <span class="pulse" aria-hidden="true"></span>
        <a href={`${base}/code`}>weathervane {latestCode.version}</a>
      </span>
      <span class="li"><span class="k">now</span> {now}</span>
    </div>

    <p class="home-hint" aria-hidden="true">the dock opens a room · or hit a workspace number</p>
  </section>
</BaseLayout>
