---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestCode } from '../lib/latestCode';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const posts = (await getCollection('posts'))
  .filter((p) => p.data.type === 'post' && p.data.status !== 'draft' && p.data.visibility !== 'private')
  .sort((a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf());

const latest = posts[0];

const readMin = (body: string) =>
  Math.max(1, Math.round(body.trim().split(/\s+/).filter(Boolean).length / 220));

const plain = (s: string) =>
  s.replace(/<[^>]+>/g, ' ').replace(/[#*_`>]/g, '').replace(/\s+/g, ' ').trim();

const excerpt = (() => {
  const raw = latest.data.excerpt || latest.data.meta_description || plain(latest.body);
  const t = plain(raw);
  return t.length > 165 ? t.slice(0, 162).replace(/\s+\S*$/, '') + '…' : t;
})();

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const latestDate = dateFmt.format(latest.data.published_at);
const latestHref = `${base}/posts/${latest.data.slug ?? latest.id}`;

// Latest code — Tempest's version comes from the GitLab API at build time (curated fallback if offline).
const latestCode = await getLatestCode();
const releaseDate = latestCode.released ? dateFmt.format(new Date(latestCode.released)) : null;
const code = {
  name: 'cosmic-ext-applet-tempest',
  lang: 'Rust',
  version: latestCode.version,
  blurb: 'A weather applet for COSMIC: forecasts, alerts, and air quality with no account or API key.',
  href: 'https://gitlab.com/vintagetechie/cosmic-ext-applet-tempest',
};

const markSrc = `${base}/favicon.svg`;
---

<BaseLayout
  title="John Crenshaw"
  description="The front door to John Crenshaw (VintageTechie): retired engineer writing essays and building Rust tools for the Linux desktop."
>
  <script is:inline slot="head">
    // Pre-paint: only the first visit (and not reduced-motion) gets the boot overlay.
    // No JS or returning visitor -> overlay stays display:none, entry shows immediately.
    try {
      if (
        !localStorage.getItem('jc_booted') &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('booting');
      }
    } catch (e) {}
  </script>

  <div class="boot-overlay" aria-hidden="true" slot="overlay">
    <div class="bl boot-dim" style="animation-delay:.06s">jcrenshaw.dev tty1</div>
    <div class="bl" style="animation-delay:.11s">&nbsp;</div>
    <div class="bl boot-dim" style="animation-delay:.17s">[    0.000018] Linux version 7.0.11-zen1-1-zen</div>
    <div class="bl boot-dim" style="animation-delay:.23s">[    0.118003] Command line: ro quiet splash</div>
    <div class="bl boot-dim" style="animation-delay:.29s">[    0.392104] Loading initial ramdisk ...</div>
    <div class="bl boot-dim" style="animation-delay:.35s">[    0.661320] systemd 257 running in system mode</div>
    <div class="bl" style="animation-delay:.41s"><span class="boot-ok">[  OK  ]</span> Reached target Local File Systems</div>
    <div class="bl" style="animation-delay:.47s"><span class="boot-ok">[  OK  ]</span> Mounted /home/john</div>
    <div class="bl" style="animation-delay:.53s"><span class="boot-ok">[  OK  ]</span> Started Network <span class="boot-dim">— gitlab.com/vintagetechie</span></div>
    <div class="bl" style="animation-delay:.59s"><span class="boot-ok">[  OK  ]</span> Loaded fonts <span class="boot-dim">— IBM Plex Mono / Sans</span></div>
    <div class="bl" style="animation-delay:.65s"><span class="boot-ok">[  OK  ]</span> Applied theme <span class="boot-dim">— Deep Slate</span></div>
    <div class="bl" style="animation-delay:.71s"><span class="boot-ok">[  OK  ]</span> Started about.service</div>
    <div class="bl" style="animation-delay:.77s"><span class="boot-ok">[  OK  ]</span> Started writing.service <span class="boot-dim">— the blog</span></div>
    <div class="bl" style="animation-delay:.83s"><span class="boot-ok">[  OK  ]</span> Started code.service <span class="boot-dim">— projects & repos</span></div>
    <div class="bl" style="animation-delay:.89s"><span class="boot-ok">[  OK  ]</span> Started contact.service</div>
    <div class="bl" style="animation-delay:.95s"><span class="boot-ok">[  OK  ]</span> Verified flatpak trust <span class="boot-dim">— single GPG root</span></div>
    <div class="bl" style="animation-delay:1.01s"><span class="boot-ok">[  OK  ]</span> Reached target <span class="boot-ac">Front Door</span></div>
    <div class="bl" style="animation-delay:1.07s">&nbsp;</div>
    <div class="bl" style="animation-delay:1.13s"><span class="boot-dim">jcrenshaw login:</span> <span class="boot-user">john</span></div>
    <div class="bl boot-user" style="animation-delay:1.20s">Welcome back, John.<span class="boot-cur"></span></div>
    <div class="boot-skip">▸ press any key to skip</div>
  </div>

  <main class="home">
    <h1 class="sr-only">John Crenshaw — essays and Rust tools for the Linux desktop</h1>

    <!-- Identity band: hero copy + callsign card -->
    <section class="top">
      <div class="hero-copy">
        <div class="hero-id">
          <img class="hero-mark" src={markSrc} alt="" width="64" height="64" />
          <div>
            <div class="hero-name">John Crenshaw</div>
            <div class="hero-role">software engineer, ret.</div>
          </div>
        </div>
        <p class="tagline">I write essays <span>and build Rust tools for the Linux desktop.</span></p>
        <p class="bio">I built other people's software since the 80s. Payment rails moving debit, credit, and ACH. HIPAA data mining. Retinal biometric access for the DoD. EPROM tooling against Intel silicon that hadn't shipped yet. The backend systems you never see. Retired now. These days I build my own, in Rust, for the Linux desktop I actually run.</p>
      </div>
      <aside class="card callsign-card">
        <div class="callsign">
          <span class="mark" aria-hidden="true"><img src={markSrc} alt="" width="54" height="54" /></span>
          <div class="nf">
            <div class="nf-host">john@jcrenshaw</div>
            <div class="nf-sep">───────────</div>
            <div class="nf-row"><span class="k">host</span><span class="v">Chicago</span></div>
            <div class="nf-row"><span class="k">uptime</span><span class="v">since 1956</span></div>
            <div class="nf-row"><span class="k">os</span><span class="v">arch · zen</span></div>
            <div class="nf-row"><span class="k">shell</span><span class="v">rust · c</span></div>
            <div class="nf-row"><span class="k">status</span><span class="v">retired</span></div>
            <div class="nf-row"><span class="k">wm</span><span class="v">cosmic</span></div>
            <div class="nf-swatch" aria-hidden="true">
              <i style="background:#e40303"></i>
              <i style="background:#ff8c00"></i>
              <i style="background:#ffed00"></i>
              <i style="background:#008026"></i>
              <i style="background:#004dff"></i>
              <i style="background:#750787"></i>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <!-- One hand: the differentiator made visible -->
    <section class="onehand">
      <p class="kicker">one hand</p>
      <h2>The writing and the tools come from the same desk.</h2>
      <p class="onehand-lead">The tools prove the essays, the essays explain the tools.</p>
      <div class="desk">
        <article class="card">
          <p class="card-label">Writing</p>
          <a class="essay-title" href={latestHref}>{latest.data.title}</a>
          <p class="essay-meta">{latestDate} · {readMin(latest.body)} min read</p>
          <p class="essay-excerpt">{excerpt}</p>
          <a class="card-link" href={latestHref}>Read the argument →</a>
        </article>

        <article class="card">
          <p class="card-label">
            Tools
            <span class="live"><span class="pulse" aria-hidden="true"></span>live</span>
          </p>
          <p class="code-name">{code.name}</p>
          <div class="badges">
            <span class="badge">{code.lang}</span>
            <span class="badge">{code.version}</span>
            <span class="badge">Flatpak</span>
          </div>
          {releaseDate && <p class="essay-meta">Latest release · {releaseDate}</p>}
          <p class="essay-excerpt">{code.blurb}</p>
          <a class="card-link" href={code.href}>Get it on GitLab ↗</a>
        </article>
      </div>
    </section>

    <!-- Close -->
    <section class="close">
      <a class="ghost" href={code.href}>Browse the code on GitLab ↗</a>
    </section>
  </main>

  <script is:inline>
    (function () {
      var html = document.documentElement;
      if (!html.classList.contains('booting')) return;
      var overlay = document.querySelector('.boot-overlay');
      var done = false;
      function end() {
        if (done) return;
        done = true;
        window.removeEventListener('keydown', end);
        window.removeEventListener('pointerdown', end);
        if (overlay) overlay.classList.add('boot-done');
        try { localStorage.setItem('jc_booted', '1'); } catch (e) {}
        setTimeout(function () {
          html.classList.remove('booting');
          if (overlay && overlay.parentNode) overlay.parentNode.removeChild(overlay);
        }, 460);
      }
      setTimeout(end, 1950);
      window.addEventListener('keydown', end);
      window.addEventListener('pointerdown', end);
    })();
  </script>

  <style>
    .home {
      flex: 1;
      width: min(880px, 100%);
      margin: 0 auto;
      padding: 40px 0 24px;
    }

    .home section {
      padding: 40px 0;
      border-bottom: 1px solid var(--line-soft);
    }
    .home section:last-of-type { border-bottom: none; }

    .kicker {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-5);
      margin: 0 0 16px;
    }

    /* Identity band: hero copy + callsign card */
    .top { display: grid; grid-template-columns: 1fr 264px; gap: 40px; align-items: start; padding-top: 8px; }
    .hero-id { display: flex; align-items: center; gap: 20px; margin-bottom: 26px; }
    .hero-mark { width: 64px; height: 64px; flex-shrink: 0; border-radius: 14px; }
    .hero-name { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); line-height: 1.1; }
    .hero-role { font-family: var(--mono); font-size: 13px; color: var(--ink-4); margin-top: 4px; }
    .tagline { font-size: 27px; font-weight: 400; color: var(--ink); max-width: 20ch; line-height: 1.26; margin: 0 0 20px; }
    .tagline span { color: var(--accent-2); font-weight: 500; }
    .bio { max-width: 52ch; font-size: 16px; color: var(--ink-3); margin: 0; }
    .callsign-card { align-self: start; }
    .callsign .mark { width: 54px; height: 54px; flex-shrink: 0; }
    .callsign .mark img { width: 100%; height: 100%; display: block; border-radius: 13px; }

    /* One hand */
    .onehand h2 { font-size: 23px; font-weight: 600; color: var(--ink); margin: 0 0 8px; line-height: 1.25; }
    .onehand-lead { max-width: 54ch; font-size: 17px; color: var(--ink-3); margin: 0 0 30px; }
    .desk { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .desk .card { display: flex; flex-direction: column; }
    .code-name { font-family: var(--mono); font-size: 15px; color: var(--ink); margin: 0 0 10px; word-break: break-word; }
    .badges { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 12px; }
    .badge { font-family: var(--mono); font-size: 12px; color: var(--ink-3); border: 1px solid var(--line); border-radius: 5px; padding: 2px 8px; background: var(--surface-3); }
    .card-link { font-family: var(--mono); font-size: 14px; color: var(--accent-2); margin-top: auto; padding-top: 4px; }
    .card-link:hover { color: var(--ink); }

    /* Close */
    .ghost { display: inline-block; border: 1px solid var(--accent-line); border-radius: 7px; padding: 9px 16px; color: var(--accent-2); font-family: var(--mono); font-size: 14px; transition: 0.18s var(--ease-out); }
    .ghost:hover { background: var(--accent-soft); color: var(--ink); }

    @media (max-width: 720px) {
      .top, .desk { grid-template-columns: 1fr; }
      .tagline { font-size: 25px; }
      .hero-name { font-size: 26px; }
    }
  </style>
</BaseLayout>
